APP_NAME=DineIQ API
DATABASE_URL=postgresql+psycopg://dineiq:change-me@localhost:5432/dineiq
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional: absolute path or path relative to this backend folder.
# YOLO_MODEL_PATH=../../downloads/models/yolo26m-seg.pt
YOLO_CONFIDENCE=0.2
# auto selects CUDA GPU 0 when available, otherwise CPU.
YOLO_DEVICE=auto
YOLO_IMAGE_SIZE=960
# FP16 on CUDA; CPU always uses FP32.
YOLO_HALF=true
